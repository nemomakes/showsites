# Free signup tracking. Leave blank until Gene turns a channel on.
# Unset Meta vars mean no pixel and no Conversions API calls.

# Numeric Meta Pixel ID. When unset, no fbevents script is rendered.
NEXT_PUBLIC_META_PIXEL_ID=

# Server pixel id. Falls back to NEXT_PUBLIC_META_PIXEL_ID.
META_PIXEL_ID=

# Graph API token for Conversions API. Never commit a real token.
META_CAPI_ACCESS_TOKEN=

# Optional. When set, Lead events are sent as Meta test events.
META_TEST_EVENT_CODE=

# Already used by POST /api/subscribe.
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=
