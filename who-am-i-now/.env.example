# Paid checkout. Leave blank until Gene creates the Stripe objects.
# Missing Stripe values make checkout return 503 "checkout not configured".
# Do not commit real values. .env.local stays gitignored.

# Secret key (sk_ or a restricted rk_). Never a publishable key.
STRIPE_SECRET_KEY=

# One-time Price IDs (price_...).
STRIPE_PRICE_KIT=
STRIPE_PRICE_CORE=

# Coupon for $27 off Next Chapter (coupon_...). Not a public promotion code.
STRIPE_COUPON_KIT_CREDIT=

# Stripe webhook signing secret (whsec_...) for POST /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# HMAC secret for kit-credit links (/next-chapter?t=) and download links.
LINK_SIGNING_SECRET=

# How long a kit-credit link stays valid. Days. Defaults to 60 when unset.
KIT_CREDIT_DAYS=60

# Optional override for the Next Chapter refund line shown on the page and at
# core checkout. When unset, the approved default is used. Do not put the kit's
# all-sales-final line here.
CORE_REFUND_POLICY=

# Already used by the free workbook form (POST /api/subscribe). Not new.
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=
